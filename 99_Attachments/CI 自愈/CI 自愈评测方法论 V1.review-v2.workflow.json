  "cards": [
    {
      "dot": "cyan",
      "title": "证据可得性与两层门禁",
      "items": [
        "易：失败・基线代码・AI 修复・验证；原始人工提交也容易获取",
        "难：调用链・动态依赖・跨仓关系・正确性判据",
        "人工归一化中难；证据缺失只影响依赖维度｜案例准入 + 逐维度门禁"
      ]
    },
    {
      "dot": "violet",
      "title": "内部 3 + 3 + 2 评测结构",
      "items": [
        "必选 3：失败对齐・因果有效性・行为一致性",
        "条件 3：已知影响完整性・门禁完整性・显式约束",
        "风险 2：修改范围・已知回归｜AI 自述与 CI 通过不是正确性证明"
      ]
    },
    {
      "dot": "amber",
      "title": "三态自动聚合与交付边界",
      "items": [
        "存在决定性冲突 → 不准确",
        "必选维度 + 适用条件维度全部支持 → 准确",
        "无冲突但关键证据不足 → 无法判断｜不平均、不投票、不交由人工组合"
      ]
    }
  ]
